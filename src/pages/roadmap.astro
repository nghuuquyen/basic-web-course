---
// Lộ trình khoá học — 6 Level — "Học Web Trong Thời Kỳ AI"
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Học Web Trong Thời Kỳ AI — Lộ Trình 6 Level</title>
  <meta name="description" content="Khoá học phát triển Web trong thời kỳ AI — từ nền tảng đến sản phẩm thật. 6 level rõ ràng, có AI challenges thực chiến." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg:         #08111f;
      --bg-soft:    #0d1929;
      --bg-card:    #101e30;
      --bg-hover:   #172538;
      --border:     #1a2d42;
      --border-md:  #243d57;
      --border-lg:  #2e4f6b;
      --text:       #e8f0f8;
      --text-2:     #7fa0be;
      --text-3:     #3d607a;
      --accent:     #38bdf8;

      --l1: #38bdf8; --l1-dim: rgba(56,189,248,.12);  --l1-bd: rgba(56,189,248,.3);
      --l2: #34d399; --l2-dim: rgba(52,211,153,.12);  --l2-bd: rgba(52,211,153,.3);
      --l3: #fbbf24; --l3-dim: rgba(251,191,36,.12);  --l3-bd: rgba(251,191,36,.3);
      --l4: #a78bfa; --l4-dim: rgba(167,139,250,.12); --l4-bd: rgba(167,139,250,.3);
      --l5: #f472b6; --l5-dim: rgba(244,114,182,.12); --l5-bd: rgba(244,114,182,.3);
      --l6: #fb923c; --l6-dim: rgba(251,146,60,.12);  --l6-bd: rgba(251,146,60,.3);
    }

    html { scroll-behavior: smooth; }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Inter', sans-serif;
      font-size: 15px;
      line-height: 1.65;
      overflow-x: hidden;
    }

    /* ════════ UTILITIES ════════ */
    .mono { font-family: 'JetBrains Mono', monospace; }
    a { color: inherit; }
    .container { max-width: 1080px; margin: 0 auto; padding: 0 1.5rem; }
    .section-gap { padding-top: 5rem; padding-bottom: 5rem; }
    .tag {
      display: inline-flex; align-items: center; gap: .35rem;
      font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
      padding: .3rem .75rem; border-radius: 100px; border: 1px solid currentColor;
    }
    .divider { border: none; border-top: 1px solid var(--border); margin: 0; }

    /* ════════ STICKY HEADER ════════ */
    .site-header {
      position: sticky; top: 0; z-index: 200;
      background: rgba(8,17,31,.85); backdrop-filter: blur(18px);
      border-bottom: 1px solid var(--border);
      height: 58px; display: flex; align-items: center;
      padding: 0 1.5rem; gap: 2rem;
    }
    .logo-link {
      font-size: 15px; font-weight: 800; text-decoration: none; color: var(--text);
      display: flex; align-items: center; gap: .5rem;
    }
    .logo-dot { width: 8px; height: 8px; border-radius: 2px; background: var(--accent); }
    .header-nav { display: flex; gap: 1.5rem; margin-left: auto; align-items: center; }
    .header-nav a {
      font-size: 13px; color: var(--text-2); text-decoration: none; transition: color .15s;
    }
    .header-nav a:hover { color: var(--text); }
    .header-nav a.active { color: var(--text); font-weight: 600; }
    .header-cta {
      background: var(--accent); color: #08111f !important;
      padding: .4rem 1rem; border-radius: 6px; font-weight: 700 !important;
      font-size: 13px !important; text-decoration: none; transition: opacity .15s;
    }
    .header-cta:hover { opacity: .88; }

    /* ════════ HERO ════════ */
    .hero {
      padding: 5.5rem 1.5rem 4rem;
      text-align: center;
      position: relative; overflow: hidden;
    }
    .hero::before {
      content: '';
      position: absolute; top: -180px; left: 50%; transform: translateX(-50%);
      width: 700px; height: 700px; border-radius: 50%;
      background: radial-gradient(circle, rgba(56,189,248,.07) 0%, transparent 70%);
      pointer-events: none;
    }
    .hero-eyebrow {
      display: inline-flex; align-items: center; gap: .5rem;
      background: rgba(56,189,248,.1); border: 1px solid rgba(56,189,248,.25);
      color: var(--l1); border-radius: 100px;
      padding: .35rem 1rem; font-size: 12px; font-weight: 600;
      letter-spacing: .06em; text-transform: uppercase; margin-bottom: 1.75rem;
    }
    .hero h1 {
      font-size: clamp(2.1rem, 5.5vw, 3.8rem); font-weight: 800; line-height: 1.1;
      max-width: 820px; margin: 0 auto 1.25rem;
    }
    .hero h1 .hl {
      background: linear-gradient(135deg, #38bdf8, #a78bfa);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    }
    .hero-sub {
      font-size: 1.05rem; color: var(--text-2);
      max-width: 560px; margin: 0 auto 2.5rem; line-height: 1.7;
    }
    .hero-actions { display: flex; gap: .75rem; justify-content: center; flex-wrap: wrap; }
    .btn {
      display: inline-flex; align-items: center; gap: .5rem;
      padding: .7rem 1.6rem; border-radius: 8px;
      font-size: 14px; font-weight: 700; text-decoration: none;
      border: none; cursor: pointer; transition: all .2s;
    }
    .btn-primary { background: linear-gradient(135deg, #38bdf8, #818cf8); color: #fff; }
    .btn-primary:hover { opacity: .88; transform: translateY(-1px); box-shadow: 0 8px 20px rgba(56,189,248,.2); }
    .btn-ghost { background: transparent; border: 1px solid var(--border-md); color: var(--text-2); }
    .btn-ghost:hover { border-color: var(--text-2); color: var(--text); }
    .hero-note { margin-top: 1.5rem; font-size: .8rem; color: var(--text-3); }

    /* ════════ INSTRUCTOR STRIP ════════ */
    .instructor-strip {
      background: var(--bg-soft); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);
      padding: 1.5rem; text-align: center;
    }
    .instructor-strip p { font-size: .875rem; color: var(--text-2); }
    .instructor-strip strong { color: var(--text); }

    /* ════════ PROBLEMS ════════ */
    .problems { background: var(--bg-soft); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
    .problems-grid {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem;
      padding-top: 3.5rem; padding-bottom: 3.5rem;
    }
    @media (max-width: 720px) { .problems-grid { grid-template-columns: 1fr; } }
    .problem-card {
      background: var(--bg-card); border: 1px solid var(--border);
      border-radius: 14px; padding: 1.5rem;
    }
    .problem-icon { font-size: 1.75rem; margin-bottom: .75rem; }
    .problem-title { font-size: .95rem; font-weight: 700; color: var(--text); margin-bottom: .5rem; }
    .problem-desc { font-size: .85rem; color: var(--text-2); line-height: 1.65; }

    /* ════════ APPROACH ════════ */
    .approach-grid {
      display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 2.5rem;
    }
    @media (max-width: 640px) { .approach-grid { grid-template-columns: 1fr; } }
    .approach-item {
      background: var(--bg-card); border: 1px solid var(--border);
      border-radius: 12px; padding: 1.25rem; display: flex; gap: 1rem;
    }
    .approach-num {
      width: 32px; height: 32px; border-radius: 8px;
      background: linear-gradient(135deg, rgba(56,189,248,.2), rgba(129,140,248,.2));
      border: 1px solid rgba(56,189,248,.3); display: flex; align-items: center; justify-content: center;
      font-size: 13px; font-weight: 800; color: var(--l1); flex-shrink: 0;
    }
    .approach-text strong { font-size: .9rem; color: var(--text); }
    .approach-text p { font-size: .82rem; color: var(--text-2); margin-top: .25rem; line-height: 1.55; }

    /* ════════ FOR WHO ════════ */
    .audience-grid {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; margin-top: 2.5rem;
    }
    @media (max-width: 720px) { .audience-grid { grid-template-columns: 1fr; } }
    .audience-card {
      background: var(--bg-card); border: 1px solid var(--border);
      border-radius: 14px; padding: 1.5rem; position: relative; overflow: hidden;
    }
    .audience-card::before {
      content: attr(data-icon); position: absolute; right: 1rem; top: 1rem;
      font-size: 2.5rem; opacity: .12;
    }
    .audience-tag {
      font-size: 10px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
      color: var(--accent); margin-bottom: .75rem;
    }
    .audience-title { font-size: .95rem; font-weight: 700; color: var(--text); margin-bottom: .5rem; }
    .audience-desc { font-size: .82rem; color: var(--text-2); line-height: 1.6; }

    /* ════════ SECTION HEADERS ════════ */
    .section-eyebrow {
      font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
      color: var(--accent); margin-bottom: .75rem;
    }
    .section-title { font-size: clamp(1.4rem, 3vw, 2rem); font-weight: 800; margin-bottom: .75rem; }
    .section-sub { font-size: .9rem; color: var(--text-2); max-width: 560px; }

    /* ════════ STATS ════════ */
    .stats-row {
      display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 3rem;
      padding: 1.75rem; background: var(--bg-card); border: 1px solid var(--border);
      border-radius: 16px;
    }
    .stat { flex: 1; min-width: 80px; text-align: center; }
    .stat-n { font-size: 1.9rem; font-weight: 800; color: var(--text); line-height: 1; }
    .stat-l { font-size: 11px; color: var(--text-3); text-transform: uppercase; letter-spacing: .06em; margin-top: .2rem; }

    /* ════════ PATH MAP ════════ */
    .path-section { background: var(--bg-soft); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
    .path-map-wrap {
      background: var(--bg-card); border: 1px solid var(--border);
      border-radius: 16px; padding: 2.5rem 2rem; margin-top: 2rem;
      overflow-x: auto;
    }
    .path-flow {
      display: flex; align-items: flex-start; justify-content: center;
      gap: 0; min-width: 560px;
    }
    .path-node { display: flex; flex-direction: column; align-items: center; gap: .6rem; }
    .path-circle {
      width: 68px; height: 68px; border-radius: 16px;
      border: 2px solid var(--color); background: var(--bg);
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      cursor: pointer; transition: all .22s; position: relative;
    }
    .path-circle:hover { background: var(--bg-hover); transform: translateY(-3px); box-shadow: 0 8px 20px rgba(0,0,0,.4); }
    .path-circle-lv { font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: var(--color); opacity: .7; }
    .path-circle-n { font-size: 20px; font-weight: 800; color: var(--color); line-height: 1; }
    .path-label { font-size: 11px; font-weight: 600; color: var(--text-2); text-align: center; max-width: 76px; line-height: 1.3; }
    .path-arrow { color: var(--text-3); font-size: 1.2rem; padding: 0 .35rem; padding-top: 1.5rem; flex-shrink: 0; }
    .path-ai-note {
      text-align: center; margin-top: 2rem;
      font-size: .8rem; color: var(--text-3);
      display: flex; align-items: center; justify-content: center; gap: .5rem;
    }
    .path-ai-note span { padding: .2rem .6rem; border-radius: 4px; background: rgba(56,189,248,.08); border: 1px solid rgba(56,189,248,.2); color: var(--l1); font-family: 'JetBrains Mono', monospace; font-size: 11px; }

    /* ════════ TIMELINE STRIP ════════ */
    .tl-strip {
      display: flex; border: 1px solid var(--border); border-radius: 12px;
      overflow: hidden; margin-bottom: 2rem; background: var(--bg-card);
    }
    .tl-item {
      flex: 1; padding: .9rem .6rem; text-align: center; cursor: pointer;
      border-right: 1px solid var(--border); transition: background .15s; position: relative;
    }
    .tl-item:last-child { border-right: none; }
    .tl-item::after {
      content: ''; position: absolute; bottom: 0; left: 0; right: 0;
      height: 2px; background: var(--color); transform: scaleX(0); transition: transform .2s;
    }
    .tl-item:hover::after, .tl-item.active::after { transform: scaleX(1); }
    .tl-item:hover, .tl-item.active { background: var(--bg-hover); }
    .tl-lv { font-size: 10px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--color); }
    .tl-name { font-size: 12px; font-weight: 600; color: var(--text); margin-top: .15rem; line-height: 1.25; }

    /* ════════ LEVEL CARDS ════════ */
    .levels { display: flex; flex-direction: column; gap: 1rem; }

    .lcard {
      background: var(--bg-card); border: 1px solid var(--border);
      border-radius: 16px; overflow: hidden; transition: border-color .2s;
    }
    .lcard:hover { border-color: var(--border-md); }
    .lcard.open { border-color: var(--color) !important; }

    .lcard-header {
      display: flex; align-items: center; gap: 1.25rem;
      padding: 1.4rem 1.6rem; cursor: pointer; user-select: none;
    }
    .lcard-badge {
      width: 52px; height: 52px; border-radius: 13px; flex-shrink: 0;
      border: 2px solid var(--color); background: var(--bg);
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      color: var(--color);
    }
    .lcard-badge span:first-child { font-size: 9px; font-weight: 700; text-transform: uppercase; opacity: .7; }
    .lcard-badge span:last-child { font-size: 19px; font-weight: 800; line-height: 1; }
    .lcard-meta { flex: 1; min-width: 0; }
    .lcard-title { font-size: 1.1rem; font-weight: 700; color: var(--text); }
    .lcard-quote { font-size: .82rem; color: var(--text-2); font-style: italic; margin-top: .15rem; }
    .lcard-pills { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .55rem; }
    .pill {
      font-size: 10px; padding: .2rem .6rem; border-radius: 100px;
      background: var(--bg); border: 1px solid var(--border); color: var(--text-3);
    }
    .pill-ai {
      font-size: 10px; padding: .2rem .6rem; border-radius: 100px;
      background: rgba(56,189,248,.08); border: 1px solid rgba(56,189,248,.25); color: var(--l1);
    }
    .lcard-toggle {
      width: 30px; height: 30px; flex-shrink: 0; border-radius: 7px;
      border: 1px solid var(--border); background: transparent;
      color: var(--text-3); cursor: pointer; display: flex; align-items: center; justify-content: center;
      font-size: 17px; transition: all .15s;
    }
    .lcard-toggle:hover { border-color: var(--color); color: var(--color); }

    /* ════════ CARD BODY ════════ */
    .lcard-body { display: none; border-top: 1px solid var(--border); }
    .lcard.open .lcard-body { display: block; }

    .lcard-inner {
      padding: 1.5rem 1.6rem;
      display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;
    }
    @media (max-width: 700px) { .lcard-inner { grid-template-columns: 1fr; } }
    .full-col { grid-column: 1 / -1; }

    /* Story */
    .story {
      background: var(--bg); border: 1px solid var(--border);
      border-left: 3px solid var(--color); border-radius: 12px; padding: 1.2rem 1.25rem;
    }
    .box-label {
      font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em;
      margin-bottom: .65rem;
    }
    .story .box-label { color: var(--color); }
    .story p { font-size: .855rem; color: var(--text-2); line-height: 1.72; }
    .story em { color: var(--text); font-style: italic; }
    .story strong { color: var(--text); font-style: normal; }

    /* Info box */
    .ibox {
      background: var(--bg); border: 1px solid var(--border);
      border-radius: 12px; padding: 1.2rem 1.25rem;
    }
    .ibox .box-label { color: var(--text-3); }

    /* Goals */
    .goals { list-style: none; display: flex; flex-direction: column; gap: .55rem; }
    .goals li { display: flex; align-items: flex-start; gap: .55rem; font-size: .845rem; color: var(--text-2); }
    .goals li::before { content: '✓'; color: var(--color); font-weight: 700; font-size: .78rem; flex-shrink: 0; margin-top: .15rem; }

    /* Content table */
    .ctable { width: 100%; border-collapse: collapse; font-size: .83rem; }
    .ctable th {
      text-align: left; padding: .45rem .65rem;
      color: var(--text-3); font-size: 10px; text-transform: uppercase; letter-spacing: .05em;
      border-bottom: 1px solid var(--border); font-weight: 600;
    }
    .ctable td { padding: .6rem .65rem; border-bottom: 1px solid rgba(255,255,255,.035); color: var(--text-2); vertical-align: top; }
    .ctable tr:last-child td { border-bottom: none; }
    .ctable td:first-child { color: var(--text); font-weight: 500; }
    .ctable a { color: var(--color); text-decoration: none; font-family: 'JetBrains Mono', monospace; font-size: .79rem; }
    .ctable a:hover { text-decoration: underline; }

    /* AI Box */
    .ai-box {
      background: linear-gradient(135deg, rgba(56,189,248,.06), rgba(129,140,248,.06));
      border: 1px solid rgba(56,189,248,.2); border-radius: 12px; padding: 1.2rem 1.25rem;
    }
    .ai-box .box-label { color: var(--l1); }
    .ai-challenges { display: flex; flex-direction: column; gap: .65rem; margin-top: .5rem; }
    .ai-item { display: flex; gap: .75rem; align-items: flex-start; }
    .ai-num {
      width: 22px; height: 22px; border-radius: 5px; flex-shrink: 0;
      background: rgba(56,189,248,.15); border: 1px solid rgba(56,189,248,.3);
      color: var(--l1); font-size: 10px; font-weight: 800;
      display: flex; align-items: center; justify-content: center;
    }
    .ai-text strong { font-size: .83rem; color: var(--text); font-weight: 600; }
    .ai-text p { font-size: .78rem; color: var(--text-2); margin-top: .1rem; line-height: 1.55; }

    /* Challenges */
    .clist { display: flex; flex-direction: column; gap: .65rem; }
    .citem { background: var(--bg); border: 1px solid var(--border); border-radius: 8px; padding: .85rem 1rem; }
    .citem-title { display: flex; align-items: center; gap: .5rem; font-size: .845rem; font-weight: 600; color: var(--text); margin-bottom: .25rem; }
    .cbadge { font-size: 9px; padding: .15rem .4rem; border-radius: 4px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; }
    .cbadge-quiz  { background: rgba(56,189,248,.15);  color: #38bdf8; }
    .cbadge-build { background: rgba(52,211,153,.15);  color: #34d399; }
    .cbadge-review { background: rgba(251,191,36,.15); color: #fbbf24; }
    .cbadge-opt   { background: rgba(100,100,100,.15); color: #7a8fa3; }
    .citem-desc { font-size: .79rem; color: var(--text-3); line-height: 1.55; }

    /* Progression */
    .progress-bar {
      grid-column: 1 / -1; border: 1px dashed var(--border-md);
      border-radius: 10px; padding: .9rem 1.2rem;
      display: flex; align-items: flex-start; gap: .9rem;
    }
    .progress-bar .ico { font-size: 1.15rem; flex-shrink: 0; margin-top: .05rem; }
    .progress-bar p { font-size: .845rem; color: var(--text-2); }
    .progress-bar strong { color: var(--text); }

    /* ════════ INSTRUCTOR ════════ */
    .instructor-card {
      background: var(--bg-card); border: 1px solid var(--border);
      border-radius: 20px; padding: 2.5rem; margin-top: 2rem;
      display: flex; gap: 2rem; align-items: flex-start;
    }
    @media (max-width: 640px) { .instructor-card { flex-direction: column; } }
    .instr-avatar {
      width: 80px; height: 80px; border-radius: 16px; flex-shrink: 0;
      background: linear-gradient(135deg, #1e3a5f, #0d2035);
      border: 2px solid var(--border-md);
      display: flex; align-items: center; justify-content: center;
      font-size: 2.2rem;
    }
    .instr-name { font-size: 1.15rem; font-weight: 800; color: var(--text); margin-bottom: .3rem; }
    .instr-role { font-size: .82rem; color: var(--l1); font-weight: 600; margin-bottom: .75rem; }
    .instr-bio { font-size: .855rem; color: var(--text-2); line-height: 1.7; }
    .instr-creds { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1rem; }
    .cred {
      font-size: 11px; padding: .3rem .7rem; border-radius: 6px;
      background: var(--bg); border: 1px solid var(--border); color: var(--text-2);
      display: flex; align-items: center; gap: .35rem;
    }

    /* ════════ PRICING ════════ */
    .pricing-grid {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; margin-top: 2.5rem;
    }
    @media (max-width: 820px) { .pricing-grid { grid-template-columns: 1fr; } }

    .pricing-card {
      background: var(--bg-card); border: 1px solid var(--border);
      border-radius: 16px; padding: 1.75rem; position: relative; display: flex; flex-direction: column;
      transition: border-color .2s;
    }
    .pricing-card:hover { border-color: var(--border-md); }
    .pricing-card.featured {
      border-color: var(--l1) !important;
      background: linear-gradient(160deg, rgba(56,189,248,.06), var(--bg-card));
    }
    .pricing-badge-top {
      position: absolute; top: -1px; left: 50%; transform: translateX(-50%);
      background: var(--l1); color: #08111f;
      font-size: 10px; font-weight: 800; padding: .25rem .85rem;
      border-radius: 0 0 8px 8px; letter-spacing: .06em; text-transform: uppercase; white-space: nowrap;
    }
    .pricing-name { font-size: .8rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--text-2); margin-bottom: .75rem; }
    .pricing-price { font-size: 2.2rem; font-weight: 800; color: var(--text); line-height: 1; }
    .pricing-price sub { font-size: .75rem; font-weight: 500; color: var(--text-2); vertical-align: baseline; }
    .pricing-desc { font-size: .8rem; color: var(--text-3); margin: .5rem 0 1.25rem; }
    .pricing-features { list-style: none; display: flex; flex-direction: column; gap: .55rem; flex: 1; }
    .pricing-features li { display: flex; gap: .6rem; font-size: .82rem; color: var(--text-2); }
    .pricing-features li::before { content: '✓'; color: var(--l2); flex-shrink: 0; font-weight: 700; font-size: .78rem; }
    .pricing-features li.dim { color: var(--text-3); }
    .pricing-features li.dim::before { content: '–'; color: var(--text-3); }
    .pricing-btn {
      margin-top: 1.5rem; display: block; text-align: center; text-decoration: none;
      padding: .7rem; border-radius: 8px; font-size: 14px; font-weight: 700; transition: all .2s;
    }
    .pricing-btn-outlined { border: 1px solid var(--border-md); color: var(--text-2); }
    .pricing-btn-outlined:hover { border-color: var(--text-2); color: var(--text); }
    .pricing-btn-filled { background: var(--l1); color: #08111f; }
    .pricing-btn-filled:hover { opacity: .88; transform: translateY(-1px); }
    .pricing-note { text-align: center; margin-top: 2rem; font-size: .8rem; color: var(--text-3); }

    /* ════════ TRIAL ════════ */
    .trial-box {
      background: var(--bg-soft); border: 1px solid var(--border);
      border-radius: 16px; padding: 2.5rem; margin-top: 2rem;
      display: grid; grid-template-columns: 1fr auto; gap: 2rem; align-items: center;
    }
    @media (max-width: 600px) { .trial-box { grid-template-columns: 1fr; } }
    .trial-box h3 { font-size: 1.25rem; font-weight: 800; margin-bottom: .5rem; }
    .trial-box p { font-size: .875rem; color: var(--text-2); }
    .free-tag {
      font-size: 11px; font-weight: 700; letter-spacing: .07em; text-transform: uppercase;
      color: var(--l2); background: rgba(52,211,153,.1); border: 1px solid rgba(52,211,153,.25);
      padding: .25rem .7rem; border-radius: 4px; display: inline-block; margin-bottom: .75rem;
    }

    /* ════════ FAQ ════════ */
    .faq { display: flex; flex-direction: column; gap: .65rem; margin-top: 2rem; }
    .faq-item { background: var(--bg-card); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; }
    .faq-q {
      padding: 1rem 1.25rem; cursor: pointer; display: flex; justify-content: space-between; align-items: center;
      font-size: .875rem; font-weight: 600; color: var(--text); user-select: none;
    }
    .faq-q span { color: var(--text-3); font-size: 1.1rem; transition: transform .2s; }
    .faq-item.open .faq-q span { transform: rotate(45deg); }
    .faq-a { display: none; padding: 0 1.25rem 1rem; font-size: .845rem; color: var(--text-2); line-height: 1.7; border-top: 1px solid var(--border); padding-top: .85rem; }
    .faq-item.open .faq-a { display: block; }

    /* ════════ FINAL CTA ════════ */
    .final-cta {
      background: linear-gradient(135deg, rgba(56,189,248,.08), rgba(129,140,248,.08));
      border: 1px solid rgba(56,189,248,.2); border-radius: 20px;
      padding: 3.5rem 2rem; text-align: center; margin-top: 2rem;
    }
    .final-cta h2 { font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: 800; margin-bottom: 1rem; }
    .final-cta p { font-size: .9rem; color: var(--text-2); max-width: 480px; margin: 0 auto 2rem; }

    /* ════════ FOOTER ════════ */
    footer {
      border-top: 1px solid var(--border); padding: 2rem 1.5rem;
      text-align: center; font-size: .8rem; color: var(--text-3);
    }
    footer a { color: var(--text-2); text-decoration: none; }
    footer a:hover { color: var(--text); }

    /* ════════ SCROLL ANIMATION ════════ */
    .fade-up { opacity: 0; transform: translateY(18px); transition: opacity .5s, transform .5s; }
    .fade-up.visible { opacity: 1; transform: none; }

    /* ════════ RESPONSIVE HELPERS ════════ */
    @media (max-width: 500px) {
      .hero h1 { font-size: 1.85rem; }
      .tl-strip { display: none; }
      .path-arrow { display: none; }
      .path-flow { flex-wrap: wrap; gap: .75rem; justify-content: center; }
    }
  </style>
</head>
<body>

  <!-- ──────────── HEADER ──────────── -->
  <header class="site-header">
    <a href={`${base}/`} class="logo-link">
      <span class="logo-dot"></span>
      The Web Basic
    </a>
    <nav class="header-nav">
      <a href={`${base}/`}>Tài liệu</a>
      <a href={`${base}/schedule`}>Lịch học</a>
      <a href={`${base}/roadmap`} class="active">Lộ trình</a>
      <a href="#pricing" class="header-cta">Đăng ký khoá học</a>
    </nav>
  </header>

  <!-- ──────────── HERO ──────────── -->
  <section class="hero">
    <div style="max-width:900px; margin: 0 auto;">
      <div class="hero-eyebrow">⚡ Khoá học thực chiến · 6 Level · AI-era</div>
      <h1>Học Phát Triển Web<br/><span class="hl">Trong Thời Kỳ AI</span></h1>
      <p class="hero-sub">Không chỉ học cách tạo website bằng AI — mà học cách <strong>hiểu, đánh giá, và phát triển kỹ năng lâu dài</strong> cùng AI. Từ nền tảng đến sản phẩm thật, đủ để đưa vào CV.</p>
      <div class="hero-actions">
        <a href="#pricing" class="btn btn-primary">
          <span>Đăng ký khoá học</span>
          <span>→</span>
        </a>
        <a href="#levels" class="btn btn-ghost">Xem lộ trình 6 level</a>
      </div>
      <p class="hero-note">Xem thử miễn phí · Không cần thẻ tín dụng</p>
    </div>
  </section>

  <!-- ──────────── INSTRUCTOR STRIP ──────────── -->
  <!-- <div class="instructor-strip">
    <p>
      Giảng dạy bởi <strong>Kỹ sư phần mềm · Thạc sĩ KHMT · Hơn 10 năm kinh nghiệm</strong>
      · Từng làm dự án cho thị trường Nhật Bản, Hong Kong, Pháp
      · Giảng viên thỉnh giảng Đại học tại Đà Nẵng · Đào tạo hàng trăm sinh viên
    </p>
  </div> -->

  <!-- ──────────── PROBLEMS ──────────── -->
  <section class="problems">
    <div class="container" style="padding-top: 3.5rem; padding-bottom: 0;">
      <div class="section-eyebrow">Tại sao cần khoá học này?</div>
      <h2 class="section-title">Dùng AI nhiều không có nghĩa là học tốt hơn</h2>
      <p class="section-sub">Quan sát trong nhiều khoá giảng dạy cho thấy ba vấn đề cốt lõi mà người học thường gặp khi kết hợp AI vào việc học lập trình Web:</p>
    </div>
    <div class="container">
      <div class="problems-grid">
        <div class="problem-card">
          <div class="problem-icon">⚠️</div>
          <div class="problem-title">Dùng AI để hoàn thành — không phải để hiểu</div>
          <div class="problem-desc">Hoàn thành bài tập bằng AI là một chuyện. Giữ được kiến thức đó sau một năm là chuyện khác. Khi môn Web học ở năm 2–3 nhưng phải đến năm 4–5 mới đi thực tập, phần lớn những gì đã dùng AI để "làm xong" sẽ không còn ở lại.</div>
        </div>
        <div class="problem-card">
          <div class="problem-icon">🔍</div>
          <div class="problem-title">Không có nền tảng để đánh giá kết quả AI</div>
          <div class="problem-desc">AI có thể tạo ra HTML không semantic, JavaScript có lỗ hổng bảo mật, hay database schema chưa hợp lý — và người không có nền tảng sẽ không nhận ra điều đó. Chất lượng kết quả AI phụ thuộc vào khả năng đánh giá của người dùng, không phải chỉ vào AI.</div>
        </div>
        <div class="problem-card">
          <div class="problem-icon">🧩</div>
          <div class="problem-title">Chưa nắm cơ chế làm việc với AI</div>
          <div class="problem-desc">Làm việc hiệu quả với AI không phải là biết cách prompt hay dùng tool nào. Nó xoay quanh bốn khái niệm nền tảng: <strong>Model, Context, Memory, Plan</strong>. Không phân biệt được những thứ này, dùng tool xịn đến đâu cũng khó cải thiện đáng kể.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ──────────── APPROACH ──────────── -->
  <section class="section-gap container fade-up">
    <div class="section-eyebrow">Cách tiếp cận của khoá học</div>
    <h2 class="section-title">Nền tảng đủ để làm chủ AI — không phải nền tảng toàn diện</h2>
    <p class="section-sub">Khoá học không cố gắng dạy hết mọi thứ về Web. Mục tiêu là giúp bạn có đủ kiến thức để đọc hiểu, đánh giá và kiểm soát những gì AI tạo ra — rồi tiếp tục tự học từ đó.</p>
    <div class="approach-grid">
      <div class="approach-item">
        <div class="approach-num">1</div>
        <div class="approach-text">
          <strong>Học đủ để đánh giá — không phải học để thay thế AI</strong>
          <p>Mỗi chủ đề được học đủ sâu để bạn có thể nhận ra khi AI tạo ra thứ gì đó không đúng. Không cần biết thuộc lòng — cần biết đủ để hỏi đúng câu và đọc hiểu câu trả lời.</p>
        </div>
      </div>
      <div class="approach-item">
        <div class="approach-num">2</div>
        <div class="approach-text">
          <strong>Thực hành với AI trong từng ngữ cảnh cụ thể</strong>
          <p>Mỗi level có AI Challenges riêng: học bằng AI, debug với AI, review code bằng AI, lên plan với AI. Không phải lý thuyết về AI — mà là luyện tập thực tế trong từng tình huống bạn sẽ gặp.</p>
        </div>
      </div>
      <div class="approach-item">
        <div class="approach-num">3</div>
        <div class="approach-text">
          <strong>Xây dựng trực giác về Context, Memory, Plan</strong>
          <p>Cùng một câu hỏi — context khác nhau cho kết quả hoàn toàn khác. Khoá học xây dựng trực giác về điều này theo từng level, không dạy lý thuyết rồi để bạn tự suy ra.</p>
        </div>
      </div>
      <div class="approach-item">
        <div class="approach-num">4</div>
        <div class="approach-text">
          <strong>Mỗi level kết thúc bằng một thứ chạy được thật sự</strong>
          <p>Không có bài kiểm tra lý thuyết cuối level. Bạn build một thứ gì đó deploy được — và đó là bằng chứng bạn hiểu đủ để tiếp tục. Đến Level 5, project đó đủ để đưa vào CV.</p>
        </div>
      </div>
    </div>

    <!-- Stats -->
    <div class="stats-row">
      <div class="stat"><div class="stat-n">6</div><div class="stat-l">Levels</div></div>
      <div class="stat"><div class="stat-n">5</div><div class="stat-l">Modules</div></div>
      <div class="stat"><div class="stat-n">5</div><div class="stat-l">Labs</div></div>
      <div class="stat"><div class="stat-n">3</div><div class="stat-l">Deep Dives</div></div>
      <div class="stat"><div class="stat-n">18+</div><div class="stat-l">AI Challenges</div></div>
      <div class="stat"><div class="stat-n">1</div><div class="stat-l">Portfolio Project</div></div>
    </div>
  </section>

  <!-- ──────────── FOR WHO ──────────── -->
  <section class="section-gap container fade-up">
    <div class="section-eyebrow">Khoá học này dành cho ai?</div>
    <h2 class="section-title">Ba nhóm học viên khoá học hướng đến</h2>
    <div class="audience-grid">
      <div class="audience-card" data-icon="🎓">
        <div class="audience-tag">Nhóm 1</div>
        <div class="audience-title">Sinh viên CNTT đang theo học (năm 2–4)</div>
        <div class="audience-desc">Đang học các môn liên quan đến Web và muốn dùng AI như một công cụ học tập thực sự — không chỉ để hoàn thành bài tập, mà để hiểu và giữ được kiến thức đó sau kỳ thi và sau khi ra trường.</div>
      </div>
      <div class="audience-card" data-icon="💼">
        <div class="audience-tag">Nhóm 2</div>
        <div class="audience-title">Người mới ra trường hoặc dưới 1,5 năm kinh nghiệm</div>
        <div class="audience-desc">Đã học nhưng cảm thấy khoảng cách giữa những gì biết và những gì công việc thực tế đòi hỏi vẫn còn lớn. Muốn cập nhật cách làm việc trong môi trường mà AI đã là một phần bình thường của quy trình.</div>
      </div>
      <div class="audience-card" data-icon="🔧">
        <div class="audience-tag">Nhóm 3</div>
        <div class="audience-title">Kỹ sư ngành kỹ thuật khác muốn bổ sung Web</div>
        <div class="audience-desc">Có nền tảng kỹ thuật từ các lĩnh vực như Data, IoT, tự động hoá, hay hệ thống nhúng — nhưng chưa có kinh nghiệm phát triển Web. Muốn học có hệ thống, không phải tự mò từng tutorial rời rạc.</div>
      </div>
    </div>
  </section>

  <!-- ──────────── PATH MAP ──────────── -->
  <section class="path-section">
    <div class="container" style="padding-top: 3.5rem; padding-bottom: 3.5rem;">
      <div class="section-eyebrow">Lộ trình học tập</div>
      <h2 class="section-title">6 Level — mỗi level là một đích đến hoàn chỉnh</h2>
      <p class="section-sub">Không cần hoàn thành toàn bộ để có giá trị. Mỗi level bạn đạt được là một kỹ năng cụ thể, làm được việc cụ thể.</p>
      <div class="path-map-wrap">
        <div class="path-flow">
          {[
            {n:'1',name:'Khám Phá',color:'var(--l1)',id:'level-1'},
            {n:'2',name:'Hiện Diện',color:'var(--l2)',id:'level-2'},
            {n:'3',name:'Tương Tác',color:'var(--l3)',id:'level-3'},
            {n:'4',name:'Xây Công Cụ',color:'var(--l4)',id:'level-4'},
            {n:'5',name:'Xây Sản Phẩm',color:'var(--l5)',id:'level-5'},
            {n:'6',name:'Vận Hành',color:'var(--l6)',id:'level-6'},
          ].map((lv, i, arr) => (
            <>
              <div class="path-node">
                <div class="path-circle" style={`--color:${lv.color}`} data-target={lv.id}>
                  <span class="path-circle-lv">LV</span>
                  <span class="path-circle-n">{lv.n}</span>
                </div>
                <div class="path-label" style={`color:${lv.color}`}>{lv.name}</div>
              </div>
              {i < arr.length - 1 && <div class="path-arrow">→</div>}
            </>
          ))}
        </div>
        <div class="path-ai-note">
          <span>🤖 AI Challenge</span>
          mỗi level đều có bài tập prompting, debug với AI, và dùng AI để tự ôn tập
        </div>
      </div>
    </div>
  </section>

  <!-- ──────────── LEVELS DETAIL ──────────── -->
  <section class="section-gap container" id="levels">
    <div class="section-eyebrow">Chi tiết từng level</div>
    <h2 class="section-title">Bấm để xem đầy đủ nội dung</h2>
    <p class="section-sub" style="margin-bottom: 2rem;">Câu chuyện · Đích đến · Tài liệu học · AI Challenges · Điều kiện lên level</p>

    <!-- Timeline strip -->
    <div class="tl-strip">
      <div class="tl-item active" style="--color:var(--l1)" data-tl="level-1"><div class="tl-lv">Level 1</div><div class="tl-name">Khám Phá</div></div>
      <div class="tl-item" style="--color:var(--l2)" data-tl="level-2"><div class="tl-lv">Level 2</div><div class="tl-name">Hiện Diện</div></div>
      <div class="tl-item" style="--color:var(--l3)" data-tl="level-3"><div class="tl-lv">Level 3</div><div class="tl-name">Tương Tác</div></div>
      <div class="tl-item" style="--color:var(--l4)" data-tl="level-4"><div class="tl-lv">Level 4</div><div class="tl-name">Xây Công Cụ</div></div>
      <div class="tl-item" style="--color:var(--l5)" data-tl="level-5"><div class="tl-lv">Level 5</div><div class="tl-name">Xây Sản Phẩm</div></div>
      <div class="tl-item" style="--color:var(--l6)" data-tl="level-6"><div class="tl-lv">Level 6</div><div class="tl-name">Vận Hành</div></div>
    </div>

    <div class="levels">

      <!-- ══════════ LEVEL 1 ══════════ -->
      <div class="lcard open" id="level-1" style="--color:var(--l1)">
        <div class="lcard-header" onclick="toggleLevel('level-1')">
          <div class="lcard-badge"><span>LV</span><span>1</span></div>
          <div class="lcard-meta">
            <div class="lcard-title">Khám Phá — Web hoạt động thế nào?</div>
            <div class="lcard-quote">"Mình dùng cùng AI với bạn, sao kết quả khác nhau vậy?"</div>
            <div class="lcard-pills">
              <span class="pill">Module 0 · Module 1</span>
              <span class="pill">2 Quizzes</span>
              <span class="pill">Không cần code</span>
              <span class="pill-ai">🤖 2 AI Challenges</span>
            </div>
          </div>
          <button class="lcard-toggle">−</button>
        </div>
        <div class="lcard-body">
          <div class="lcard-inner">

            <div class="story full-col">
              <div class="box-label">📖 Câu chuyện</div>
              <p>Khoa — sinh viên năm 2 ngành CNTT — bắt đầu học môn Phát triển Web. Ngồi cạnh một bạn cũng dùng ChatGPT nhưng code chạy ngon hơn, giải thích rõ hơn, thầy khen nhiều hơn. Khoa hỏi tại sao thì bạn nói: <em>"Tao cũng không biết, tao chỉ hỏi khác mày một chút thôi."</em> Khoa nhìn lại câu hỏi của mình — và của bạn. Câu của bạn dài hơn, rõ hơn, có context hơn. Nhưng tại sao context đó lại quan trọng? Tại sao AI cần biết những thứ đó? <strong>Level 1 không dạy code — nó giải thích tại sao mọi thứ tồn tại, để câu hỏi tiếp theo của bạn tốt hơn.</strong></p>
            </div>

            <div class="ibox">
              <div class="box-label">🎯 Đích đến</div>
              <ul class="goals">
                <li>Giải thích "khi gõ google.com có 6 việc xảy ra" cho người không học IT</li>
                <li>Nhìn lỗi 404, 500, timeout — biết ngay xuất phát từ đâu</li>
                <li>Phân biệt frontend, backend, database và tại sao cần cả ba</li>
                <li>Biết cách prompt AI để giải thích khái niệm, kiểm tra hiểu biết của mình</li>
                <li>Tạo flashcard ôn tập bằng AI — không bao giờ quên sau kỳ thi</li>
              </ul>
            </div>

            <div class="ibox">
              <div class="box-label">📚 Nội dung học</div>
              <table class="ctable">
                <thead><tr><th>Tài liệu</th><th>Nội dung chính</th></tr></thead>
